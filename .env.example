# Copy to .env.local and adjust. Never commit real values.

# Path to the local SQLite database file (created automatically).
NARZAALAI_DB_PATH=data/narzaalai.db

# Directory for uploaded documents (served only through authorised routes).
NARZAALAI_UPLOAD_DIR=data/uploads

# Used ONLY by `npm run seed` (development/demo). Seeding refuses to run when NODE_ENV=production.
SEED_PASSWORD=change-me-before-demo

# Optional: staff bootstrap for a fresh deployment (`npm run migrate` creates the admin if both are set
# and no admin exists). Use a strong, unique password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Number of reverse proxies YOU operate in front of the app (used only as a rate-limit key). 1 = one proxy (default),
# 0 = the app is exposed directly. See docs/DEPLOYMENT.md.
TRUSTED_PROXY_HOPS=1

# `npm run backup` destination and number of backups to keep (0/unset = keep all). Uploads must be copied separately.
NARZAALAI_BACKUP_DIR=data/backups
KEEP=14

# Placeholders for a possible future hosted backend. NOT read by the application today; leave commented.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never expose to the client
